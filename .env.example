# =====================================================================
# SOLO para desarrollo con `npm run dev` (http://localhost:5173).
# En Docker/AWS estas variables se pasan desde el .env de la raíz
# (FRONT_CLIENT_ID, ENTRA_TENANT_ID, API_SCOPE) al construir la imagen.
# =====================================================================

# ---- Microsoft Entra ID (App Registration del FRONTEND - SPA)
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000

# ---- Scope expuesto por la App Registration de la API
VITE_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user

# ---- Backend. En desarrollo apunta al BFF local.
# Déjalo vacío para usar el mismo dominio del frontend (así funciona en AWS).
VITE_API_BASE_URL=http://localhost:8080

# ---- Opcionales: por defecto se usa el origen actual (http://localhost:5173)
# VITE_ENTRA_REDIRECT_URI=http://localhost:5173
# VITE_ENTRA_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/login
